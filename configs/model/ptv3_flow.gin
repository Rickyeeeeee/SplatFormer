FeaturePredictor.input_features = ['means', 'scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowPredictor.sh_degree = 1
GSFlowPredictor.output_head_nlayer = 4
GSFlowPredictor.output_head_type = 'mlp-relu'
GSFlowPredictor.grid_resolution = 1024
GSFlowPredictor.resume_ckpt = None
GSFlowPredictor.input_features = ['means', 'scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowPredictor.output_features = ['means', 'scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowPredictor.output_head_width = 128
GSFlowPredictor.zeroinit = True
GSFlowPredictor.quat_residual_mode = "add" #[add, mul]
GSFlowPredictor.input_feat_to_mlp = True
GSFlowPredictor.fourier_input_features = []
GSFlowPredictor.fourier_num_frequencies = {}
GSFlowPredictor.fourier_include_raw = True
GSFlowPredictor.fourier_log_sampling = True
GSFlowPredictor.fourier_max_frequency_log2 = {}
GSFlowPredictor.res_feature_activation = {
    "means": @Tanh(),
    "features_dc": @Identity(),
    "features_rest": @Identity(),
    "scales": @Identity(),
    "opacities": @Identity(),
    "quats": @Identity(),
}

PointTransformerV3FlowModel.enable_flash = True
PointTransformerV3FlowModel.output_dim = 128
PointTransformerV3FlowModel.enc_dim = 64
PointTransformerV3FlowModel.turn_off_bn = False
PointTransformerV3FlowModel.stride = (1,2,2,2)
PointTransformerV3FlowModel.embedding_type = 'MLP'
PointTransformerV3FlowModel.T_dim = 3
PointTransformerV3FlowModel.enc_depths=(2,2,2,6,2)
PointTransformerV3FlowModel.dec_depths=(2,2,2,2)
PointTransformerV3FlowModel.enc_num_head=(2,4,8,16,32)
PointTransformerV3FlowModel.dec_num_head=(4,4,8,16)
