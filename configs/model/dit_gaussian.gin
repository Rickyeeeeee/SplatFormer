# Standalone classic DiT Gaussian velocity predictor; no trainer wiring.
GaussianDiTPredictor.sh_degree = 0
GaussianDiTPredictor.max_gaussians = 1000
# Use 'morton_rank' with targets sorted by Morton order for fixed index embeddings.
GaussianDiTPredictor.coordinate_mode = 'current'

GaussianDiT.depth = 12
GaussianDiT.channels = 384
GaussianDiT.num_heads = 6
GaussianDiT.mlp_ratio = 4
GaussianDiT.frequency_embedding_size = 256
GaussianDiT.patch_size = 1
