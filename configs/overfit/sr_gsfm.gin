# Unified all-attribute GSFM training with four alignment modes.
set_seed.seed = 42

total_steps = 200000
training.total_steps = %total_steps
training.pretrain_steps = 0
training.eval_interval = 2000
training.save_interval = 2000
training.log_interval = 20
training.log_image_interval = 2000
training.grad_clip_norm = 2.0
training.image_l1_loss_weight = 1.0
training.lpips_loss_weight = 1.0
training.resume_from_step = 0
training.enable_amp = True
training.empty_cache_fre = -1

flow_matching.flow_steps = 5
flow_matching.flow_noise_std = 0.0
flow_matching.flow_t_eps = 1e-4
flow_matching.loss_type = 'velocity'
flow_matching.velocity_variance_floor = 1e-8

loss_mixing.schedule = 'free-range-gs'

# Fixed-cardinality gsplat fit that establishes the flow target correspondence.
matching_total_steps = 2000
matching_fit.total_steps = %matching_total_steps
matching_fit.image_per_step = 32
matching_fit.log_interval = 20
matching_fit.preview_interval = 200
matching_fit.grad_clip_norm = 0.0
matching_fit.image_l1_loss_weight = 1.0
matching_fit.lpips_loss_weight = 1.0
matching_fit.enable_amp = True
matching_fit.empty_cache_fre = -1

matching_fit/build_3DGSoptimizer.lr_dict = {
    'base': 1e-3,
    'means': 1.6e-4,
    'features_dc': 2.5e-3,
    'features_rest': 1.25e-4,
    'opacities': 5e-2,
    'scales': 5e-3,
    'quats': 1e-3,
}
matching_fit/build_3DGSoptimizer.optimizer_type = 'adam'
matching_fit/build_3DGSoptimizer.optimizer_params = {'eps': 1e-15}
matching_fit/build_scheduler.total_step = %matching_total_steps
matching_fit/build_scheduler.schedule = 'constant'

# All six Gaussian attributes are always supervised.
# These weights apply to the x1 objective; velocity loss uses unit attribute weights.
feature_mse_loss.loss_weights = {
    'means': 100.0,
    'features_dc': 1.0,
    'features_rest': 1.0,
    'opacities': 1.0,
    'scales': 1.0,
    'quats': 10.0,
}
feature_mse_loss.quat_direct_mse = False

train2D/build_optimizer.lr_dict = {
    'base': 3e-4,
    'embedding': 3e-4,
    'backbone': 3e-4,
    'features_dc': 3e-4,
    'features_rest': 1.5e-6,
    'scales': 3e-3,
    'opacities': 3e-4,
    'quats': 3e-4,
    'means': 3e-4,
}
train2D/build_optimizer.optimizer_type = 'adam'
train2D/build_optimizer.optimizer_params = {'eps': 1e-15}
train2D/build_scheduler.total_step = %total_steps
train2D/build_scheduler.schedule = 'linear'

SplatFactoMultiLevelDataset.remove_outlier_ndevs = -1
SplatFactoMultiLevelDataset.image_per_scene = None
SplatFactoMultiLevelDataset.sample_ratio_test = None
SplatFactoMultiLevelDataset.max_gs_num = 1000000
SplatFactoMultiLevelDataset.load_pose_src = 'nerfstudio'

train_dataset/SplatFactoMultiLevelDataset.train_or_test = 'test'
train_dataset/SplatFactoMultiLevelDataset.nerfstudio_folder = '/project/ricky/splatformer-data/overfit-data-256/nerfstudio'
train_dataset/SplatFactoMultiLevelDataset.colmap_folder = '/project/ricky/splatformer-data/overfit-data-256/colmap'
train_dataset/SplatFactoMultiLevelDataset.image_per_scene = 16
train_dataset/SplatFactoMultiLevelDataset.sample_ratio_test = 0.7
train_dataset/SplatFactoMultiLevelDataset.split_across_gpus = True
train_dataset/SplatFactoMultiLevelDataset.factors = [1, 2, 4]
