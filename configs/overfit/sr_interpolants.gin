# Unified all-attribute GSFM training with four alignment modes.
set_seed.seed = 42

total_steps = 200000
training.total_steps = %total_steps
training.eval_interval = 2000
training.save_interval = 2000
training.log_interval = 20
training.log_image_interval = 2000
training.grad_clip_norm = 2.0
training.image_l1_loss_weight = 1.0
training.lpips_loss_weight = 1.0
training.resume_from_step = 0
training.enable_amp = True
training.empty_cache_fre = -1

flow_matching.flow_steps = 10
flow_matching.flow_noise_std = 1.0
flow_matching.interpolant_type = 'linear'
flow_matching.loss_rollout_steps = 10
flow_matching.eval_noise_seed = 0
flow_matching.flow_t_eps = 1e-4
flow_matching.loss_type = 'velocity'
flow_matching.normalization_variance_floor = 1e-8

loss_mixing.schedule = 'fm-only'

# Standardized velocities are unbounded and additive for every attribute.
GSFlowPredictor.quat_residual_mode = 'add'
GSFlowPredictor.res_feature_activation = {
    'means': @Identity(), 'features_dc': @Identity(), 'features_rest': @Identity(),
    'scales': @Identity(), 'opacities': @Identity(), 'quats': @Identity(),
}

DiffusionGaussianPredictor.quat_residual_mode = 'add'
DiffusionGaussianPredictor.res_feature_activation = {
    'means': @Identity(), 'features_dc': @Identity(), 'features_rest': @Identity(),
    'scales': @Identity(), 'opacities': @Identity(), 'quats': @Identity(),
}

train2D/build_optimizer.lr_dict = {
    'base': 3e-4,
    'embedding': 3e-4,
    'backbone': 3e-4,
    'features_dc': 3e-4,
    'features_rest': 1.5e-6,
    'scales': 3e-3,
    'opacities': 3e-4,
    'quats': 3e-4,
    'means': 3e-4,
}
train2D/build_optimizer.optimizer_type = 'adam'
train2D/build_optimizer.optimizer_params = {'eps': 1e-15}
train2D/build_scheduler.total_step = %total_steps
train2D/build_scheduler.schedule = 'cosine'
