set_seed.seed = 42

# training.total_steps is retained for compatibility. overfit-sr-ar.py derives
# the actual budget from ar_num_stages * ar_steps_per_stage.
total_steps = 1000
training.total_steps = %total_steps
training.pretrain_steps = 0
training.ar_num_stages = 10
training.ar_steps_per_stage = 100
training.eval_interval = 200
training.save_interval = 200
training.log_interval = 20
training.log_image_interval = 200
training.grad_clip_norm = 2.0
training.resume_from_step = 0
training.enable_amp = True
training.empty_cache_fre = -1
training.image_l1_loss_weight = 1.0
training.lpips_loss_weight = 1.0

train2D/build_optimizer.lr_dict = {
    "base": 3e-4,
    "embedding": 3e-4,
    "backbone": 3e-4,
    "features_dc": 3e-4,
    "features_rest": 1.5e-6,
    "scales": 3e-4,
    "opacities": 3e-4,
    "quats": 3e-4,
    "means": 3e-4
}
train2D/build_optimizer.optimizer_type = 'adam'
train2D/build_optimizer.optimizer_params = {'eps': 1e-15}
train2D/build_scheduler.total_step = %total_steps
train2D/build_scheduler.schedule = 'constant'

SplatFactoMultiLevelDataset.remove_outlier_ndevs = -1
SplatFactoMultiLevelDataset.image_per_scene = None
SplatFactoMultiLevelDataset.sample_ratio_test = None
SplatFactoMultiLevelDataset.max_gs_num = 100000
SplatFactoMultiLevelDataset.load_pose_src = 'nerfstudio'

train_dataset/SplatFactoMultiLevelDataset.train_or_test = 'test'
train_dataset/SplatFactoMultiLevelDataset.nerfstudio_folder = '/project/ricky/splatformer-data/overfit-data-256/nerfstudio'
train_dataset/SplatFactoMultiLevelDataset.colmap_folder = '/project/ricky/splatformer-data/overfit-data-256/colmap'
train_dataset/SplatFactoMultiLevelDataset.sample_ratio_test = 0.7
train_dataset/SplatFactoMultiLevelDataset.cache_steps = 1
train_dataset/SplatFactoMultiLevelDataset.cache_num_scenes = 1
train_dataset/SplatFactoMultiLevelDataset.split_across_gpus = True
train_dataset/SplatFactoMultiLevelDataset.factors = [2, 4]

GSFlowFeaturePredictor.sh_degree = 1
GSFlowFeaturePredictor.output_head_nlayer = 4
GSFlowFeaturePredictor.output_head_type = 'mlp-relu'
GSFlowFeaturePredictor.max_scale_normalized = 1e-2
GSFlowFeaturePredictor.grid_resolution = 384
GSFlowFeaturePredictor.resume_ckpt = None
GSFlowFeaturePredictor.input_features = ['means','scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowFeaturePredictor.output_features = ['means','scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowFeaturePredictor.output_head_width = 128
GSFlowFeaturePredictor.zeroinit = True
GSFlowFeaturePredictor.res_feature_activation = {
    "means": @Tanh(),
    "features_dc": @Identity(),
    "features_rest": @Identity(),
    "scales": @Identity(),
    "opacities": @Identity(),
    "quats": @Identity()
}
GSFlowFeaturePredictor.input_embed_to_mlp = False
GSFlowFeaturePredictor.input_feat_to_mlp = True

PointTransformerV3FlowModel.enable_flash = True
PointTransformerV3FlowModel.output_dim = 96
PointTransformerV3FlowModel.enc_dim = 64
PointTransformerV3FlowModel.turn_off_bn = False
PointTransformerV3FlowModel.stride = (1,2,2,2)
PointTransformerV3FlowModel.T_dim = 128

