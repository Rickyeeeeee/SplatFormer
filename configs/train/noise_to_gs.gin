# Unconditional Morton-rank Gaussian DiT with fixed-count targets.
set_seed.seed = 42
training.total_steps = 100000
training.eval_interval = 5000
training.save_interval = 5000
training.log_interval = 20
training.grad_clip_norm = 2.0
training.enable_amp = True

training_augmentation.random_rotate = False
training_augmentation.rotation_mode = 'gravity_consistent'
training_augmentation.rotation_max_degrees = None
training_augmentation.rotation_pivot = (0.5, 0.5, 0.5)

flow_matching.flow_steps = 50
flow_matching.coupling = 'random'
flow_matching.flow_t_eps = 1e-4
flow_matching.eval_noise_seed = 0
flow_matching.normalization_variance_floor = 1e-8

train2D/build_optimizer.lr_dict = {
    'base': 3e-4, 'embedding': 3e-4, 'backbone': 3e-4,
    'features_dc': 3e-4, 'features_rest': 1.5e-6,
    'scales': 3e-3, 'opacities': 3e-4, 'quats': 3e-4, 'means': 3e-4,
}
train2D/build_optimizer.optimizer_type = 'adam'
train2D/build_optimizer.optimizer_params = {'eps': 1e-15}
train2D/build_scheduler.total_step = 100000
train2D/build_scheduler.schedule = 'cosine'
train2D/build_scheduler.warmup_step = 0
train2D/build_scheduler.warmup_start_factor = 0.03333333333333333
