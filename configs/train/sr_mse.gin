set_seed.seed = 42
total_steps = 200000
training.total_steps = %total_steps
training.eval_interval = 2000
training.save_interval = 2000
training.log_interval = 20
training.log_image_interval = 2000
training.grad_clip_norm = 2.0
training.resume_from_step = 0
training.enable_amp = True
training.empty_cache_fre = -1

# Point-wise MSE supervises all six Gaussian attributes.
gaussian_attribute_loss_config.loss_weights = {
    "means": 100.0,
    "features_dc": 1.0,
    "features_rest": 1.0,
    "opacities": 1.0,
    "scales": 1.0,
    "quats": 10.0,
}
gaussian_attribute_loss_config.quat_direct_mse = False

train2D/build_optimizer.lr_dict = {
    "base": 3e-5,
    "embedding": 3e-5,
    "backbone": 3e-5,
    "features_dc": 3e-5,
    "features_rest": 1.5e-6,
    "scales": 3e-5,
    "opacities": 3e-5,
    "quats": 3e-5,
    "means": 3e-5
}
train2D/build_optimizer.optimizer_type = 'adam'
train2D/build_optimizer.optimizer_params = {'eps': 1e-15}
train2D/build_scheduler.total_step = %total_steps
train2D/build_scheduler.schedule = 'constant'


# GS-only training; evaluation retains images for render metrics.
SplatFactoSRDevDataset.max_gs_num = 100000
train_dataset/SplatFactoSRDevDataset.load_src_gs = True
train_dataset/SplatFactoSRDevDataset.load_tgt_gs = True
train_dataset/SplatFactoSRDevDataset.load_src_images = False
train_dataset/SplatFactoSRDevDataset.load_tgt_images = False
train_dataset/SplatFactoSRDevDataset.split_across_gpus = False
