test_dataset/SplatFactoMultiLevelDataset.train_or_test = 'test'
test_dataset/SplatFactoMultiLevelDataset.nerfstudio_folder = '/project/ricky/splatformer-data/test-set-512/objaverse/nerfstudio'
test_dataset/SplatFactoMultiLevelDataset.colmap_folder = '/project/ricky/splatformer-data/test-set-512/objaverse/colmap'
test_dataset/SplatFactoMultiLevelDataset.image_per_scene = None
test_dataset/SplatFactoMultiLevelDataset.cache_steps = 1
test_dataset/SplatFactoMultiLevelDataset.cache_num_scenes = 1
test_dataset/SplatFactoMultiLevelDataset.split_across_gpus = False
test_dataset/SplatFactoMultiLevelDataset.factors = [1, 4]

# Flow scripts use a separate predictor/backbone path owned by gs_flow.py.
GSFlowFeaturePredictor.sh_degree = 1
GSFlowFeaturePredictor.output_head_nlayer = 4
GSFlowFeaturePredictor.output_head_type = 'mlp-relu'
GSFlowFeaturePredictor.max_scale_normalized = 1e-2
GSFlowFeaturePredictor.grid_resolution = 384
GSFlowFeaturePredictor.resume_ckpt = None
GSFlowFeaturePredictor.input_features = ['means','scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowFeaturePredictor.output_features = ['means','scales', 'opacities', 'quats', 'features_dc', 'features_rest']
GSFlowFeaturePredictor.output_head_width = 128
GSFlowFeaturePredictor.zeroinit = True
GSFlowFeaturePredictor.res_feature_activation = {
    "means": @Tanh(),
    "features_dc": @Identity(),
    "features_rest": @Identity(),
    "scales": @Identity(),
    "opacities": @Identity(),
    "quats": @Identity()
}
GSFlowFeaturePredictor.input_embed_to_mlp = False
GSFlowFeaturePredictor.input_feat_to_mlp = True
PointTransformerV3FlowModel.enable_flash = True
PointTransformerV3FlowModel.output_dim = 96
PointTransformerV3FlowModel.enc_dim = 64
PointTransformerV3FlowModel.turn_off_bn = False
PointTransformerV3FlowModel.stride = (1,2,2,2)
PointTransformerV3FlowModel.T_dim = 128
